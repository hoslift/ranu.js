{
  "name": "ranu-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "adapters/*",
    "create-ranu",
    "examples/*",
    "fixtures/*",
    "tooling/*"
  ],
  "version": "0.0.0",
  "description": "Ranu.js — JavaScript/TypeScript Full-Stack Web Framework (monorepo root)",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "tsc --noEmit",
    "test": "pnpm -r test",
    "test:unit": "pnpm -r --filter './packages/*' --filter './adapters/*' --filter './create-ranu' test",
    "test:integration": "vitest run tests/integration",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "pnpm -r clean && rimraf coverage test-results playwright-report",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "check-cycles": "node scripts/check-cycles.mjs",
    "check-exports": "node scripts/check-exports.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.5",
    "@eslint/js": "^9.30.1",
    "@types/node": "^22.20.1",
    "eslint": "^9.30.1",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.35.1",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hoslift/ranu.js.git"
  },
  "license": "MIT"
}
