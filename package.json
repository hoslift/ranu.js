{
  "name": "ranu-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "adapters/*",
    "create-ranu",
    "examples/*",
    "fixtures/*",
    "tooling/*"
  ],
  "version": "0.0.0",
  "description": "Ranu.js — JavaScript/TypeScript Full-Stack Web Framework (monorepo root)",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "tsc --noEmit",
    "test": "pnpm -r test",
    "test:unit": "pnpm -r --filter './packages/*' --filter './adapters/*' --filter './create-ranu' test",
    "test:api": "vitest run tests/api",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage --coverage.exclude=scripts/** --coverage.exclude=**/test/** --coverage.exclude=**/*.d.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "node scripts/ci-clean.mjs",
    "ci:verify": "pnpm typecheck && pnpm build && pnpm lint && pnpm test && pnpm test:api && pnpm test:integration && pnpm check-cycles && pnpm check-exports",
    "ci:clean": "pnpm clean && pnpm install --frozen-lockfile && pnpm ci:verify",
    "prepr": "pnpm ci:clean",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "check-cycles": "node scripts/check-cycles.mjs",
    "check-exports": "node scripts/check-exports.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.5",
    "@eslint/js": "^9.30.1",
    "@types/node": "^22.20.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.2.5",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.30.1",
    "prettier": "^3.5.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hoslift/ranu.js.git"
  },
  "license": "MIT"
}
