{
  "name": "ranu-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "adapters/*",
    "create-ranu",
    "examples/*",
    "fixtures/*",
    "tooling/*"
  ],
  "version": "0.0.0",
  "description": "Ranu.js — JavaScript/TypeScript Full-Stack Web Framework (monorepo root)",
  "license": "MIT",
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/draj256"
    },
    {
      "type": "paypal",
      "url": "https://www.paypal.com/donate/?hosted_button_id=G8MDMN2AGD5UJ"
    }
  ],
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter \"!example-*\" build",
    "typecheck": "tsc --noEmit",
    "test": "pnpm -r test",
    "test:unit": "pnpm -r --filter './packages/*' --filter './adapters/*' --filter './create-ranu' test",
    "test:api": "vitest run tests/api",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --project packages --project adapters --project create-ranu --project integration --coverage --coverage.exclude=scripts/** --coverage.exclude=vitest.workspace.ts --coverage.exclude=**/test/** --coverage.exclude=**/*.d.ts --coverage.exclude=**/tsup.config.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "node scripts/ci-clean.mjs",
    "ci:verify": "pnpm typecheck && pnpm build && pnpm lint && pnpm test && pnpm test:api && pnpm test:integration && pnpm test:cli && pnpm test:perf && pnpm test:examples && pnpm check-cycles && pnpm check-exports && node scripts/sync-docs-version.mjs --check",
    "ci:clean": "pnpm clean && pnpm install --frozen-lockfile && pnpm ci:verify",
    "prepr": "pnpm ci:clean",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm sync:docs",
    "release": "pnpm -r publish --access public --no-git-checks",
    "sync:docs": "node scripts/sync-docs-version.mjs",
    "check-cycles": "node scripts/check-cycles.mjs",
    "check-exports": "node scripts/check-exports.mjs",
    "test:cli": "vitest run tests/cli",
    "test:deployment": "vitest run tests/deployment",
    "test:security": "vitest run tests/security",
    "test:perf": "vitest run tests/performance",
    "test:examples": "vitest run tests/examples",
    "bench:baseline": "node scripts/generate-baseline.mjs",
    "test:smoke": "vitest run tests/smoke",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.5",
    "@eslint/js": "^9.30.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.4",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.2.5",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.30.1",
    "prettier": "^3.9.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hoslift/ranu.js.git"
  },
  "license": "MIT"
}
