{
  "name": "create-ranujs",
  "version": "0.1.5",
  "description": "Create a new Ranu.js project",
  "license": "MIT",
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/draj256"
    },
    {
      "type": "paypal",
      "url": "https://www.paypal.com/donate/?hosted_button_id=G8MDMN2AGD5UJ"
    }
  ],
  "type": "module",
  "private": false,
  "bin": {
    "create-ranujs": "./dist/bin/create-ranu.js",
    "create-ranu": "./dist/bin/create-ranu.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hoslift/ranu.js.git",
    "directory": "create-ranu"
  },
  "keywords": [
    "ranu",
    "create",
    "scaffold",
    "framework",
    "typescript",
    "react"
  ]
