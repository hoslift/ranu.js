{
  "name": "@ranu/cli",
  "version": "0.1.0",
  "description": "ranu CLI implementation (internal)",
  "license": "MIT",
  "type": "module",
  "private": true,
  "bin": {
    "ranu": "./dist/bin/ranu.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@ranu/core": "workspace:*",
    "@ranu/config": "workspace:*",
    "@ranu/diagnostics": "workspace:*",
    "@ranu/build": "workspace:*",

    "@ranu/dev": "workspace:*",
    "@ranu/runtime-node": "workspace:*",
    "@ranujs/adapter-vercel": "workspace:*",
    "@ranujs/adapter-cloudflare": "workspace:*",
    "@ranujs/adapter-node": "workspace:*",
    "@ranujs/adapter-netlify": "workspace:*",
    "@ranujs/adapter-bun": "workspace:*",
    "@ranujs/adapter-deno": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  }
}
