{
  "name": "@ranu/cli",
  "version": "0.0.0",
  "description": "ranu CLI implementation (internal)",
  "license": "MIT",
  "type": "module",
  "private": true,
  "bin": {
    "ranu": "./dist/bin/ranu.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@ranu/core": "workspace:*",
    "@ranu/config": "workspace:*",
    "@ranu/diagnostics": "workspace:*",
    "@ranu/build": "workspace:*",
    "@ranu/dev": "workspace:*",
    "@ranu/runtime-node": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.15.32",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
