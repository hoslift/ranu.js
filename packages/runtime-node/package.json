{
  "name": "@ranu/runtime-node",
  "version": "0.4.1",
  "description": "Ranu.js Node.js HTTP runtime bridge (internal)",
  "license": "MIT",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@ranu/core": "workspace:*",
    "@ranu/diagnostics": "workspace:*",
    "@ranu/manifests": "workspace:*",
    "@ranu/react": "workspace:*",
    "@ranu/router": "workspace:*",
    "@ranu/runtime": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "rimraf": "^6.1.4",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
