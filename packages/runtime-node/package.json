{
  "name": "@ranu/runtime-node",
  "version": "0.0.0",
  "description": "Ranu.js Node.js HTTP runtime bridge (internal)",
  "license": "MIT",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@ranu/core": "workspace:*",
    "@ranu/diagnostics": "workspace:*",
    "@ranu/manifests": "workspace:*",
    "@ranu/runtime": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.1",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  }
}
