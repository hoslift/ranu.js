{
  "name": "@ranujs/core",
  "version": "0.4.1",
  "description": "Ranu.js — JavaScript/TypeScript Full-Stack Web Framework",
  "license": "MIT",
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/hoslift"
    },
    {
      "type": "paypal",
      "url": "https://www.paypal.com/donate/?hosted_button_id=G8MDMN2AGD5UJ"
    }
  ],
  "type": "module",
  "private": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "bin": {
    "ranu": "./dist/bin/ranu.js",
    "ranujs": "./dist/bin/ranu.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./devtools": {
      "types": "./dist/devtools.d.ts",
      "import": "./dist/devtools.js"
    },
    "./server-only": {
      "types": "./dist/server-only.d.ts",
      "import": "./dist/server-only.js"
    },
    "./ai": {
      "types": "./dist/ai.d.ts",
      "import": "./dist/ai.js"
    },
    "./ai/gemini": {
      "types": "./dist/ai/gemini.d.ts",
      "import": "./dist/ai/gemini.js"
    },
    "./ai/groq": {
      "types": "./dist/ai/groq.d.ts",
      "import": "./dist/ai/groq.js"
    },
    "./ai/claude": {
      "types": "./dist/ai/claude.d.ts",
      "import": "./dist/ai/claude.js"
    },
    "./ai/codex": {
      "types": "./dist/ai/codex.d.ts",
      "import": "./dist/ai/codex.js"
    },
    "./ai/openai": {
      "types": "./dist/ai/openai.d.ts",
      "import": "./dist/ai/openai.js"
    },
    "./ai/custom": {
      "types": "./dist/ai/custom.d.ts",
      "import": "./dist/ai/custom.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "dotenv": "^18.0.9",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@ranu/ai": "workspace:*",
    "@ranu/ai-claude": "workspace:*",
    "@ranu/ai-custom": "workspace:*",
    "@ranu/ai-gemini": "workspace:*",
    "@ranu/ai-groq": "workspace:*",
    "@ranu/ai-codex": "workspace:*",
    "@ranu/build": "workspace:*",
    "@ranu/cli": "workspace:*",
    "@ranu/config": "workspace:*",
    "@ranu/core": "workspace:*",
    "@ranu/dev": "workspace:*",
    "@ranu/devtools": "workspace:*",
    "@ranu/diagnostics": "workspace:*",
    "@ranu/manifests": "workspace:*",
    "@ranu/plugin": "workspace:*",
    "@ranu/react": "workspace:*",
    "@ranu/router": "workspace:*",
    "@ranu/runtime": "workspace:*",
    "@ranu/runtime-node": "workspace:*",
    "@ranu/server": "workspace:*",
    "@ranu/testing": "workspace:*",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "rimraf": "^6.1.4",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    },
    "react-dom": {
      "optional": false
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hoslift/ranu.js.git",
    "directory": "packages/ranu"
  },
  "keywords": [
    "framework",
    "javascript",
    "typescript",
    "react",
    "full-stack",
    "ssr",
    "ssg",
    "web",
    "router"
  ]
}
