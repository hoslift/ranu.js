{
  "name": "@ranujs/core",
  "version": "0.1.5",
  "description": "Ranu.js — JavaScript/TypeScript Full-Stack Web Framework",
  "license": "MIT",
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/draj256"
    },
    {
      "type": "paypal",
      "url": "https://www.paypal.com/donate/?hosted_button_id=G8MDMN2AGD5UJ"
    }
  ],
  "type": "module",
  "private": false,
  "sideEffects": false,
  "bin": {
    "ranu": "./dist/bin/ranu.js",
    "ranujs": "./dist/bin/ranu.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    },
    "./server-only": {
      "types": "./dist/server-only.d.ts",
      "import": "./dist/server-only.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "dotenv": "^18.0.5",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@ranu/build": "workspace:*",
    "@ranu/cli": "workspace:*",
    "@ranu/config": "workspace:*",
    "@ranu/core": "workspace:*",
    "@ranu/dev": "workspace:*",
    "@ranu/diagnostics": "workspace:*",
    "@ranu/manifests": "workspace:*",
    "@ranu/plugin": "workspace:*",
    "@ranu/react": "workspace:*",
    "@ranu/router": "workspace:*",
    "@ranu/runtime": "workspace:*",
    "@ranu/runtime-node": "workspace:*",
    "@ranu/server": "workspace:*",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    },
    "react-dom": {
      "optional": false
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hoslift/ranu.js.git",
    "directory": "packages/ranu"
  },
  "keywords": [
    "framework",
    "javascript",
    "typescript",
    "react",
    "full-stack",
    "ssr",
    "ssg",
    "web",
    "router"
  ]
}
