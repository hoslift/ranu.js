{
  "name": "ranu",
  "version": "0.0.0",
  "description": "Ranu.js — JavaScript/TypeScript Full-Stack Web Framework",
  "license": "MIT",
  "type": "module",
  "private": false,
  "sideEffects": false,
  "engines": {
    "node": ">=22.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    },
    "./server-only": {
      "types": "./dist/server-only.d.ts",
      "import": "./dist/server-only.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@ranu/config": "workspace:*",
    "@ranu/core": "workspace:*",
    "@ranu/plugin": "workspace:*",
    "@ranu/react": "workspace:*",
    "@ranu/server": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    },
    "react-dom": {
      "optional": false
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hoslift/ranu.js.git",
    "directory": "packages/ranu"
  },
  "keywords": [
    "framework",
    "javascript",
    "typescript",
    "react",
    "full-stack",
    "ssr",
    "ssg",
    "web",
    "router"
  ]
}
