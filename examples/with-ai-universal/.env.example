# Model-Agnostic AI Provider Configuration
# Supported providers: openai | gemini | anthropic | local
AI_PROVIDER=openai

# OpenAI / OpenAI-compatible (DeepSeek, Groq, Together)
AI_API_KEY=your_secret_api_key_here
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL_NAME=gpt-4o-mini

# Google Gemini (if AI_PROVIDER=gemini)
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL_NAME=gemini-1.5-flash

# Anthropic Claude (if AI_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL_NAME=claude-3-5-sonnet-20241022

# Local Model Runner / Ollama (if AI_PROVIDER=local)
# AI_LOCAL_URL=http://127.0.0.1:11434/api/chat
# AI_LOCAL_MODEL=llama3
