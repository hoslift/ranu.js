{
  "name": "@ranu/ai-custom",
  "version": "0.1.0",
  "description": "Custom OpenAI-compatible and Ollama model driver for Ranu.js with enterprise proxies, DeepSeek-R1 reasoning, and W3C streaming",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@ranu/ai": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
