{
  "name": "@ranu/adapter-template",
  "version": "0.1.0",
  "description": "Boilerplate template for authoring Ranu.js deployment adapters",
  "license": "MIT",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@ranu/core": "workspace:*",
    "@ranu/manifests": "workspace:*"
  },
  "devDependencies": {
    "rimraf": "^6.1.4",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
